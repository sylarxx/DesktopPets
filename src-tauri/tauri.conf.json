{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "华力AI桌面助手",
  "mainBinaryName": "HualiAIDesktopAssistant",
  "version": "1.0.54",
  "identifier": "com.huali.ai.mascot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/before-build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "mascot",
        "title": "华力AI桌面助手",
        "url": "index.html?window=mascot",
        "width": 120,
        "height": 104,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "closable": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "panel",
        "title": "华力AI桌面助手",
        "url": "index.html?window=panel",
        "width": 380,
        "height": 78,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "closable": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "mascot-menu",
        "title": "华力AI桌面助手",
        "url": "index.html?window=mascot-menu",
        "width": 216,
        "height": 76,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "closable": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "mascot-notification",
        "title": "华力AI桌面助手",
        "url": "index.html?window=mascot-notification",
        "width": 320,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "closable": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "华力 AI 桌面助手",
    "longDescription": "华力 AI 桌面助手，支持一句话创建待办、任务推送和 Web 平台联动。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["huali-ai-mascot"]
      }
    }
  }
}
