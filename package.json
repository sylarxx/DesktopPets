{
  "name": "huali-ai-mascot",
  "version": "1.0.53",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode prod",
    "dev:main": "vite --mode main",
    "build": "npm run build:prod",
    "build:prod": "vue-tsc --noEmit && vite build --mode prod",
    "build:main": "vue-tsc --noEmit && vite build --mode main",
    "build:intranet": "vue-tsc --noEmit && vite build --mode intranet",
    "test": "vitest run",
    "mascot:prepare": "node scripts/prepare-mascot-sprite.mjs",
    "mock:api": "node scripts/mock-api.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:windows-installer:prod": "BUILD_MODE=prod bash scripts/build-windows-installer.sh",
    "build:windows-installer:main": "BUILD_MODE=main bash scripts/build-windows-installer.sh",
    "build:windows-installer:intranet": "BUILD_MODE=intranet bash scripts/build-windows-installer.sh",
    "build:windows-silent-installer:prod": "BUILD_MODE=prod bash scripts/build-windows-silent-installer.sh",
    "build:windows-silent-installer:main": "BUILD_MODE=main bash scripts/build-windows-silent-installer.sh",
    "build:windows-silent-installer:intranet": "BUILD_MODE=intranet bash scripts/build-windows-silent-installer.sh",
    "build:windows-msi:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-msi.ps1 -Mode prod",
    "build:windows-msi:main": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-msi.ps1 -Mode main",
    "build:windows-msi:intranet": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-msi.ps1 -Mode intranet",
    "build:windows-portable:prod": "BUILD_MODE=prod bash scripts/build-windows-portable.sh",
    "build:windows-portable:main": "BUILD_MODE=main bash scripts/build-windows-portable.sh",
    "build:windows-portable:intranet": "BUILD_MODE=intranet bash scripts/build-windows-portable.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.2.7",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  }
}
